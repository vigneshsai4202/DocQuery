# ─────────────────────────────────────────────────────────────────────────────
# DocuQuery — environment variable reference
# Copy this file to .env and fill in your values before running the backend.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Create a free project at https://neon.tech, then copy the connection string
# from the Neon dashboard (Connection Details → psycopg2).
# Format: postgresql+psycopg2://user:password@ep-xxx-yyy.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_9pnQOwbackI0@ep-tiny-pine-a5elp9nn-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── File upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf

# ── Embeddings ────────────────────────────────────────────────────────────────
# "local"  → sentence-transformers (no API key, model downloaded on first run)
# "openai" → OpenAI embeddings API (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2   # 384-dim, ~90 MB download
EMBEDDING_DIMENSION=384

# Only needed when EMBEDDING_PROVIDER=openai:
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LLM provider ─────────────────────────────────────────────────────────────
# "ollama"      → local Ollama server (free, no API key)
#                 Install: https://ollama.com  then: ollama pull llama3.2
# "openai"      → OpenAI or any OpenAI-compatible API
# "huggingface" → Hugging Face Inference API
LLM_PROVIDER=ollama

# Ollama (default):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (set LLM_PROVIDER=openai to use):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Hugging Face (set LLM_PROVIDER=huggingface to use):
# HUGGINGFACE_API_KEY=hf_...
# HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# ── Storage paths (relative to backend/) ─────────────────────────────────────
# These default to backend/storage/uploads and backend/storage/vector_store
# UPLOAD_DIR=storage/uploads
# VECTOR_STORE_DIR=storage/vector_store
